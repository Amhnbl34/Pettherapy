# این فایل را کپی کنید به اسم .env و مقادیر را عوض کنید
PORT=3000
# شماره موبایلی که بعد از ثبت‌نام به‌طور خودکار «مدیر» می‌شود (اختیاری)
ADMIN_MOBILE=09120000000
# اگر پشت HTTPS هستید (nginx/Cloudflare) روی 1 بگذارید تا کوکی Secure شود
COOKIE_SECURE=0
# مسیر ذخیره‌ی دیتابیس و عکس‌ها
DATA_DIR=./data
# حساب مدیر کل (با اینها مستقیم از صفحه‌ی /admin وارد می‌شوید؛ بدون ثبت‌نام در سایت)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@petherapy.ir
ADMIN_PASSWORD=ChangeMe123
ADMIN_NAME=مدیر پت‌تراپی
